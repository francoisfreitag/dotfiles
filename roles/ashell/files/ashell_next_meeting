#!/usr/bin/env python3
import argparse
import enum
import json
import subprocess
import datetime
from typing import Dict


class Modes(enum.StrEnum):
    MONITOR = "monitor"
    ACTION = "action"


class EventStatus(enum.StrEnum):
    FUTURE = "FUTURE"
    UPCOMING = "UPCOMING"
    STARTED = "STARTED"
    EMPTY = "EMPTY"


def get_current_time():
    now = datetime.datetime.now()
    return now.time()


def next_event() -> Dict[str, str] | None:
    events_json = subprocess.run(
        [
            "khal",
            "list",
            "today",
            "today",
            "--json",
            "title",
            "--json",
            "start-time",
            "--json",
            "end-time",
            "--json",
            "location",
            "--json",
            "all-day",
        ],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    events = json.loads(events_json)
    meetings = [evt for evt in events if evt["all-day"] == "False"]
    meetings.sort(
        key=lambda evt: (
            evt["start-time"],
            evt["end-time"],
            evt["location"] is not None,
        )
    )
    current_time = get_current_time()
    try:
        return next(
            e
            for e in meetings
            if current_time < datetime.time.fromisoformat(e["end-time"])
        )
    except StopIteration:
        return None


def main(mode):
    if mode == Modes.MONITOR:
        event = next_event()
        if event is None:
            status = {"text": "", "alt": EventStatus.EMPTY}
        else:
            start = datetime.time.fromisoformat(event["start-time"])
            end = datetime.time.fromisoformat(event["end-time"])
            meeting_start = datetime.datetime.combine(datetime.date.today(), start)
            before_start = meeting_start - datetime.timedelta(minutes=5)
            current_time = get_current_time()
            if before_start.time() <= current_time < start:
                alt = EventStatus.UPCOMING
            elif start <= current_time <= end:
                alt = EventStatus.STARTED
            else:
                alt = EventStatus.FUTURE
            status = {
                "text": f"{event['start-time']}–{event['end-time']} {event['title'].strip()}",
                "alt": alt,
            }
        print(json.dumps(status, separators=(",", ":")))
    elif mode == Modes.ACTION:
        event = next_event()
        if event:
            url = event["location"]
            if url.startswith("https://visio.numerique.gouv.fr"):
                subprocess.run(["xdg-open", url], check=True)


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("mode", choices=Modes)
    args = parser.parse_args()
    main(args.mode)
