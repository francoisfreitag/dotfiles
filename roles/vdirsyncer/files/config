[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair nextcloud_calendar]
a = "nextcloud_remote"
b = "nextcloud_local"
collections = ["from a", "from b"]
conflict_resolution = ["command", "nvim", "-d"]
metadata = ["color", "displayname"]

[storage nextcloud_remote]
type = "caldav"
url = "https://nextcloud.franek.fr/remote.php/caldav/"
username.fetch = ["command", "secret-tool", "lookup", "name", "vdirsyncer.username"]
password.fetch = ["command", "secret-tool", "lookup", "name", "vdirsyncer.password"]

[storage nextcloud_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/nextcloud.franek.fr/"
fileext = ".ics"

[pair inclusion_calendar]
a = "inclusion_remote"
b = "inclusion_local"
collections = ["from a"]
conflict_resolution = ["command", "nvim", "-d"]
metadata = ["color", "displayname"]

[storage inclusion_remote]
type = "caldav"

url = "https://messagerie.numerique.gouv.fr/dav/caldav/Y2FsOi8vMC8zMTcy"
username.fetch = ["command", "secret-tool", "lookup", "name", "vdirsyncer.inclusion.username"]
password.fetch = ["command", "secret-tool", "lookup", "name", "vdirsyncer.inclusion.password"]

[storage inclusion_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/inclusion.gouv.fr/"
fileext = ".ics"
